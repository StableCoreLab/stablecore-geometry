cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED SCGEOMETRY_SOURCE_DIR)
    message(FATAL_ERROR "Missing SCGEOMETRY_SOURCE_DIR")
endif()
get_filename_component(SCGEOMETRY_SOURCE_DIR "${SCGEOMETRY_SOURCE_DIR}" ABSOLUTE)

# 数字越大层级越高；共享内部助手允许依赖实体层，使用方仍按自身层级递归检查。
function(module_tier relative_path output)
    if(relative_path MATCHES "^(Include|Source)/(Types|Support|Export)/")
        set(tier 0)
    elseif(relative_path MATCHES "^(Include|Source)/Geometry2d/")
        set(tier 1)
    elseif(relative_path MATCHES "^(Include|Source)/Geometry3d/")
        set(tier 2)
    elseif(relative_path MATCHES "^(Include|Source)/(Brep|Detail)/")
        set(tier 3)
    elseif(relative_path MATCHES "^(Include|Source)/Core/")
        set(tier 4)
    else()
        set(tier 5)
    endif()
    set(${output} ${tier} PARENT_SCOPE)
endfunction()

# 只解析仓库可解析的 include，不把系统和 Qt 头纳入仓库模块层级。
function(local_dependencies path output)
    string(MD5 key "${path}")
    get_property(cached GLOBAL PROPERTY "dependency_${key}" SET)
    if(cached)
        get_property(dependencies GLOBAL PROPERTY "dependency_${key}")
    else()
        file(STRINGS "${path}" lines REGEX [=[^[ 	]*#[ 	]*include[ 	]*[<"]]=])
        get_filename_component(parent "${path}" DIRECTORY)
        set(dependencies)
        foreach(line IN LISTS lines)
            string(REGEX REPLACE [=[^[ 	]*#[ 	]*include[ 	]*[<"]([^>"]+)[>"].*$]=] [=[\1]=] include_path "${line}")
            set(search_roots "${SCGEOMETRY_SOURCE_DIR}/Include" "${SCGEOMETRY_SOURCE_DIR}/Source")
            if(line MATCHES [=[include[ 	]*"]=])
                list(PREPEND search_roots "${parent}")
            endif()
            foreach(base IN LISTS search_roots)
                get_filename_component(candidate "${include_path}" ABSOLUTE BASE_DIR "${base}")
                if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
                    file(RELATIVE_PATH relative "${SCGEOMETRY_SOURCE_DIR}" "${candidate}")
                    if(relative MATCHES "^(Include|Source)/")
                        list(APPEND dependencies "${candidate}")
                    endif()
                    break()
                endif()
            endforeach()
        endforeach()
        list(REMOVE_DUPLICATES dependencies)
        set_property(GLOBAL PROPERTY "dependency_${key}" "${dependencies}")
    endif()
    set(${output} "${dependencies}" PARENT_SCOPE)
endfunction()

function(forbidden_dependency root root_tier output)
    set(${output} "" PARENT_SCOPE)
    set(queue "${root}")
    set(visited)
    while(queue)
        list(POP_FRONT queue current)
        if(current IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${current}")
        file(RELATIVE_PATH current_relative "${SCGEOMETRY_SOURCE_DIR}" "${current}")
        module_tier("${current_relative}" current_tier)
        if(current_tier GREATER root_tier AND NOT current_relative MATCHES "^Source/Detail/")
            set(${output} "${current_relative}" PARENT_SCOPE)
            return()
        endif()
        local_dependencies("${current}" dependencies)
        list(APPEND queue ${dependencies})
    endwhile()
endfunction()

# 使用内存图验证环、共享助手和兼容转发链，不写入临时源码。
set(fixture_root "${SCGEOMETRY_SOURCE_DIR}/Source/Geometry2d/__DependencyFixture.h")
set(fixture_bridge "${SCGEOMETRY_SOURCE_DIR}/Source/Detail/__DependencyFixture.h")
if(EXISTS "${fixture_root}" OR EXISTS "${fixture_bridge}")
    message(FATAL_ERROR "Dependency fixture paths must remain virtual")
endif()
string(MD5 fixture_root_key "${fixture_root}")
string(MD5 fixture_bridge_key "${fixture_bridge}")
set_property(GLOBAL PROPERTY "dependency_${fixture_root_key}" "${fixture_bridge}")
set_property(GLOBAL PROPERTY "dependency_${fixture_bridge_key}"
    "${fixture_root};${SCGEOMETRY_SOURCE_DIR}/Include/Types/Geometry2d/SCPoint2.h")
forbidden_dependency("${fixture_root}" 1 forbidden)
if(forbidden)
    message(FATAL_ERROR "Dependency verifier rejected a low-layer cycle")
endif()
set_property(GLOBAL PROPERTY "dependency_${fixture_bridge_key}"
    "${fixture_root};${SCGEOMETRY_SOURCE_DIR}/Include/Core/Projection.h")
forbidden_dependency("${fixture_root}" 1 forbidden)
if(NOT forbidden STREQUAL "Include/Core/Projection.h")
    message(FATAL_ERROR "Dependency verifier missed a shared-helper violation")
endif()
set_property(GLOBAL PROPERTY "dependency_${fixture_bridge_key}"
    "${SCGEOMETRY_SOURCE_DIR}/Include/Brep/Healing.h")
forbidden_dependency("${fixture_bridge}" 3 forbidden)
if(NOT forbidden STREQUAL "Include/Core/Healing.h")
    message(FATAL_ERROR "Dependency verifier missed a compatibility-header violation")
endif()

# 此枚举只用于检查源码，不参与库或测试目标的源文件收集。
file(GLOB_RECURSE files "${SCGEOMETRY_SOURCE_DIR}/Include/*.h" "${SCGEOMETRY_SOURCE_DIR}/Source/*.h"
                        "${SCGEOMETRY_SOURCE_DIR}/Source/*.cpp")
set(compatibility_headers
    Include/Brep/Topology.h Include/Brep/BodyBoolean.h Include/Brep/Healing.h
    Include/Brep/MeshConversion.h Include/Brep/MeshRepair.h)
set(checked 0)
foreach(root IN LISTS files)
    file(RELATIVE_PATH root_relative "${SCGEOMETRY_SOURCE_DIR}" "${root}")
    module_tier("${root_relative}" root_tier)
    if(root_tier GREATER 3 OR root_relative IN_LIST compatibility_headers)
        continue()
    endif()
    math(EXPR checked "${checked}+1")
    forbidden_dependency("${root}" ${root_tier} forbidden)
    if(forbidden)
        message(FATAL_ERROR "Module dependency violation: ${root_relative} transitively includes ${forbidden}")
    endif()
endforeach()
message(STATUS "Module dependency check passed for ${checked} low-layer files")
